# Local Supabase Edge Function runtime. Supabase supplies these automatically
# when deployed; use local development keys only with `supabase functions serve`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEYS={"default":"replace-with-local-publishable-key"}
SUPABASE_SECRET_KEYS={"default":"replace-with-local-secret-key"}
